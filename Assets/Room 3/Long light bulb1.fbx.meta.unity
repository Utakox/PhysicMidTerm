  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e50ba17086dd0d441b315907b988fb9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  manager: {fileID: 1626268670}
  lines:
  - "Well\u2026 you did it. The air flows again\u2026 but don\u2019t smile just yet."
  - "The exit\u2026 doesn\u2019t exist\u2026 not for you. Not for anyone who came
    here before."
  - "You are the last to try. Everyone else\u2026 didn\u2019t make it this far"
  - 
  - "I hope\u2026 I get to see you\u2026 just like the others in this cave\u2026"
  - "Lifeless\u2026 forgotten\u2026 their bodies\u2026 part of the walls now."
  - Goodbye.
  voices:
  - {fileID: 8300000, guid: 7057c288b0feffd45a20c00c42351df0, type: 3}
  - {fileID: 8300000, guid: 32fef26ee1c0da04b8383aec0f342b28, type: 3}
