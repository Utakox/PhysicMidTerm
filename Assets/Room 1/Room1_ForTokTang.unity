MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 697894775}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e50ba17086dd0d441b315907b988fb9a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  manager: {fileID: 0}
  lines:
  - Welcome, maintenance personnel.
  - You have been assigned to assist in system operations within this facility.
  - Your role is to ensure that all machinery is functioning within acceptable parameters.
  - Each room contains a different task that requires manual adjustment.
  - In this room, a mass calibration procedure is required
  - You must move objects into the main machine to match the required total mass.
  - Each object displays its mass on the screen.
  - The main machine requires a total mass of twenty
  - "And since you\u2019re new to maintenance\u2026 I suppose I should warn you"
  - "Not every room\u2019s operator is the same. Consider yourself lucky\u2026 your
    first assignment brought you here, with me."
  - "And\u2026 the cave operator\u2026 I really hope they don\u2019t send you there.
    Not yet, at least"
  voices:
  - {fileID: 8300000, guid: e95826484c53c2b4fa0e116e3e448db2, type: 3}
  - {fileID: 8300000, guid: 07e601edacc3233409122f170baaa183, type: 3}
